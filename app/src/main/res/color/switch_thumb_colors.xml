<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color when the switch is turned ON (Checked) -->
    <item android:state_checked="true" android:color="#00E5FF" />

    <!-- Color when the switch is turned OFF (Unchecked / Grey fallback) -->
    <item android:color="#AAAAAA" />
</selector>
