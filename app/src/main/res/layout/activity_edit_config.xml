<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp"
    tools:context=".EditConfigActivity">

    <!-- Container Card matching MainActivity style -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="18dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DEVICE CONFIGURATION"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- Signal Strength Indicator Row -->
            <LinearLayout
                android:id="@+id/layout_signal_strength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:background="#161616"
                android:padding="12dp"
                android:visibility="visible"> <!-- Change to "gone" if not connected initially -->

                <ImageView
                    android:id="@+id/iv_signal_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_signal_cellular_alt"
                    app:tint="#4A90E2"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Signal Strength" />

                <TextView
                    android:id="@+id/tv_signal_strength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal Strength: -- dBm"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 1. Device Name Input Layout -->
            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColorHint="#777777"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="#4A90E2"
                app:hintTextColor="#4A90E2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Device Name (e.g. Vehicle 001)"
                    android:inputType="text"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 2. MAC Address Input Layout -->
            <com.google.android.material.textfield.TextInputLayout
                style="?attr/textInputOutlinedStyle"
                android:id="@+id/layout_edit_mac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColorHint="#777777"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="#4A90E2"
                app:hintTextColor="#4A90E2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_edit_mac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="MAC Address (e.g. AA:BB:CC:DD:EE:FF)"
                    android:inputType="textCapCharacters"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Scan Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan_ble"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:text="Scan for Nearby Devices"
                android:textColor="#4A90E2"
                app:strokeColor="#4A90E2"
                app:cornerRadius="12dp" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_config"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Configuration"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#4A90E2"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>