<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- App Header Layout -->
    <LinearLayout
        android:id="@+id/panel_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_log_section">

        <TextView
            android:id="@+id/lbl_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wireless Start"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- More Options Menu Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="#CCCCCC"
            android:contentDescription="More options" />

    </LinearLayout>

    <!-- Grouped Card for Terminal Activity Log -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_log_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="18dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/panel_app_header"
        app:layout_constraintBottom_toTopOf="@id/recycler_vehicles"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <!-- Vertical layout for Title and Subtitle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/lbl_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ACTIVITY LOG"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lbl_log_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap for History"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Scrollable Terminal Console with Rounded Corners -->
            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_terminal_console"
                android:clipToOutline="true"
                android:padding="8dp">

                <TextView
                    android:id="@+id/txt_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00FF00"
                    android:fontFamily="monospace"
                    android:textSize="13sp" />
            </ScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- RecyclerView for Multi-Vehicle Support -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_vehicles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_vehicle_control"
        app:layout_constraintTop_toBottomOf="@id/card_log_section"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>