<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- App Header Layout -->
    <LinearLayout
        android:id="@+id/panel_app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/card_log_section">

        <TextView
            android:id="@+id/lbl_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wireless Start"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- More Options Menu Button -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="#CCCCCC"
            android:contentDescription="More options" />

    </LinearLayout>

    <!-- Grouped Card for Terminal Activity Log -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_log_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="18dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/panel_app_header"
        app:layout_constraintBottom_toTopOf="@id/card_grouped_section">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <!-- Vertical layout for Title and Subtitle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/lbl_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM ACTIVITY LOG"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lbl_log_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tap for History"
                    android:textColor="#777777"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Scrollable Terminal Console with Rounded Corners -->
            <ScrollView
                android:id="@+id/scroll_log"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_terminal_console"
                android:clipToOutline="true"
                android:padding="8dp">

                <TextView
                    android:id="@+id/txt_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00FF00"
                    android:fontFamily="monospace"
                    android:textSize="13sp" />
            </ScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Combined Card for Connectivity Status and Action Buttons / Telemetry -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_grouped_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="18dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/card_log_section"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Connectivity Status Row -->
            <LinearLayout
                android:id="@+id/panel_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="12dp">

                <!-- Status Indicator Dot -->
                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/indicator_offline"
                    android:layout_marginEnd="12dp" />

                <!-- Sci-Fi Styled Status Text -->
                <TextView
                    android:id="@+id/txt_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SYSTEMS: OFFLINE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"
                    android:fontFamily="sans-serif-medium" />

                <!-- Reconnect Button -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_reconnect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    app:tint="#00E5FF"
                    android:tooltipText="Reconnect"
                    android:contentDescription="Reconnect to BLE" />

            </LinearLayout>

            <!-- Divider Line Separating Status and Actions -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A2A"
                android:layout_marginBottom="12dp" />

            <!-- START, STOP, and Voltage Telemetry Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- START Button -->
                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="START"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4CAF50" />

                <!-- STOP Button -->
                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="STOP"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E53935" />

                <!-- Integrated Voltage Reading Telemetry Badge -->
                <LinearLayout
                    android:id="@+id/panel_voltage"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_terminal_console"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/lbl_voltage_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BATT"
                        android:textColor="#777777"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_voltage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--.--V"
                        android:textColor="#00E5FF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>