<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Terminal Activity Log Title -->
    <TextView
        android:id="@+id/lbl_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SYSTEM ACTIVITY LOG"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable Terminal Console -->
    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#000000"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_log"
        app:layout_constraintBottom_toTopOf="@id/panel_status">

        <TextView
            android:id="@+id/txt_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[CON] System pipeline core active...\n"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="13sp" />
    </ScrollView>

    <!-- Connectivity Panel -->
    <LinearLayout
        android:id="@+id/panel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#1E1E1E"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_log"
        app:layout_constraintBottom_toTopOf="@id/card_grouped_section">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="12dp"
            android:background="#F44336" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dio Hardware Offline"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="#CCCCCC"
            android:contentDescription="More options" />
    </LinearLayout>

    <!-- Grouped Card for Voltage & Start Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_grouped_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="8dp"
        app:strokeColor="#333333"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/panel_status"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Voltage Monitoring Panel with Toggle Switch -->
            <LinearLayout
                android:id="@+id/panel_voltage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" >

                <View
                    android:id="@+id/voltage_indicator"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="12dp"
                    android:background="#00BCD4" />

                <TextView
                    android:id="@+id/lbl_voltage_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Battery Voltage"
                    android:textColor="#CCCCCC"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txt_voltage_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="--.--V"
                    android:textColor="#00E5FF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_voltage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:thumbTint="@color/switch_thumb_colors"
                    app:trackTint="@color/switch_track_colors"/>
            </LinearLayout>

            <!-- Divider line between Voltage and Start section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A2A2A"
                android:layout_marginHorizontal="12dp"/>

            <!-- START Section -->
            <LinearLayout
                android:id="@+id/layout_start_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="START"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4CAF50" />

                <Spinner
                    android:id="@+id/spinner_start"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:background="#222222"
                    android:padding="8dp" />

                <EditText
                    android:id="@+id/input_custom_start"
                    android:layout_width="80dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:hint="ms"
                    android:textColorHint="#666666"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:background="#222222"
                    android:padding="8dp"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>