<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Connectivity Panel -->
    <LinearLayout
        android:id="@+id/panel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="12dp"
            android:background="#F44336" /> <!-- Defaults Red (Offline) -->

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dio Hardware Offline"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Start Button -->
    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:text="START IGNITION"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/panel_status" />

    <!-- Stop Button -->
    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:text="STOP ENGINE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E53935"
        app:layout_constraintTop_toBottomOf="@id/btn_start" />

    <!-- Terminal Activity Log Title -->
    <TextView
        android:id="@+id/lbl_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="SYSTEM ACTIVITY LOG"
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btn_stop" />

    <!-- Scrollable Terminal Console -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="#000000"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_log"
        app:layout_constraintBottom_toBottomOf="parent">

    <TextView
            android:id="@+id/txt_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[CON] System pipeline core active...\n"
            android:textColor="#00FF00"
        android:fontFamily="monospace"
        android:textSize="13sp" />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>