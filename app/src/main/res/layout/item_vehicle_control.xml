<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="18dp"
    app:strokeColor="#333333"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Vehicle Name / Identifier Row -->
        <TextView
            android:id="@+id/txt_vehicle_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle Name / Unit #1"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Connectivity Status Row -->
        <LinearLayout
            android:id="@+id/panel_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <!-- Status Indicator Dot -->
            <View
                android:id="@+id/status_indicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/indicator_offline"
                android:layout_marginEnd="12dp" />

            <!-- Sci-Fi Styled Status Text -->
            <TextView
                android:id="@+id/txt_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SYSTEMS: OFFLINE"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <!-- Reconnect Button -->
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_reconnect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                app:tint="#00E5FF"
                android:contentDescription="Reconnect to BLE" />

        </LinearLayout>

        <!-- Divider Line Separating Status and Actions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="12dp" />

        <!-- START, STOP, and Voltage Telemetry Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- START Button -->
            <Button
                android:id="@+id/btn_start"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="START"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50" />

            <!-- STOP Button -->
            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="STOP"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E53935" />

            <!-- Integrated Voltage Reading Telemetry Badge -->
            <LinearLayout
                android:id="@+id/panel_voltage"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_terminal_console"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/lbl_voltage_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATT"
                    android:textColor="#777777"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_voltage_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--.--V"
                    android:textColor="#00E5FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>